# 监控渠道注入示例（TEX-29）。真实值只经部署 secret 注入，不提交仓库。
# 未获授权前保持占位；本地演练仅 webhook 即可（P0 邮件兜底需授权后另行配置并重跑演练）。

# 本地/部署地址
GAME_SERVER_ADDR=127.0.0.1:3001
GAME_SERVER_VERSION=unknown
MONITOR_ENV=local
ALERTMANAGER_ADDR=alertmanager:9093
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9000/hook

# Grafana 本地演练管理员口令（compose 必填；不留仓库已知值，本地演练时在此设置）
GRAFANA_ADMIN_PASSWORD=

# 邮件兜底（P0 必须；需授权后填写真实 SMTP 与收件人）
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
P0_EMAIL_RECIPIENTS=
