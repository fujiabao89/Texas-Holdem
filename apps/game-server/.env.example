# Game Server 环境变量样例（不含任何密钥）。
# 非敏感运行配置，可本地覆盖。
PORT=3001
HOST=0.0.0.0

# 持久化（TEX-18）：目标 schema 默认 game（私有 schema，不暴露给 PostgREST/GraphQL）。
# DATABASE_URL 含数据库凭据，只由部署平台注入，绝不写入本文件或提交到仓库。
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
# DATABASE_SCHEMA=game
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# 集成测试数据库（TEX-12 约定）：缺省时数据库集成测试受控跳过。
# TEX_TEST_DATABASE_URL=postgres://postgres:<password>@localhost:55432/postgres
