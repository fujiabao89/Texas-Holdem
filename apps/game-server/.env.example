# Game Server 环境变量样例（不含任何密钥）。
# 非敏感运行配置，可本地覆盖。
PORT=3001
HOST=0.0.0.0

# 身份凭证（TEX-19）：playerToken 的 HMAC 摘要密钥与版本号。
# 仅存服务端环境注入，绝不写入日志、DB 或客户端；至少 32 字符。
# TOKEN_HMAC_SECRET=<random-secret-at-least-32-chars>
# TOKEN_HMAC_KEY_ID=v1

# 显式 CORS Allowlist（逗号分隔，不使用通配来源）。
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# 持久化（TEX-18）：目标 schema 默认 game（私有 schema，不暴露给 PostgREST/GraphQL）。
# DATABASE_URL 含数据库凭据，只由部署平台注入，绝不写入本文件或提交到仓库。
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
# DATABASE_SCHEMA=game
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# 集成测试数据库（TEX-12 约定）：缺省时数据库集成测试受控跳过。
# TEX_TEST_DATABASE_URL=postgres://postgres:<password>@localhost:55432/postgres

# 测试确定性洗牌（TEX-28，仅隔离测试入口设置）：令每场锦标赛按 seed 可复现，
# 用于真实链路 E2E 等。生产环境严禁设置——会令全部洗牌可预测（公平性风险）；
# game-server 在 NODE_ENV=production 时若检测到该变量会直接拒绝启动。
# TEX_TEST_RNG_SEED=280820
