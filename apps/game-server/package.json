{
  "name": "@texas-holdem/game-server",
  "version": "0.1.0",
  "private": true,
  "description": "游戏服务运行时（Node.js + Fastify + @fastify/websocket）",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/persistence/migrations/migrate.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@texas-holdem/poker-engine": "workspace:*",
    "@texas-holdem/protocol": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0"
  }
}
