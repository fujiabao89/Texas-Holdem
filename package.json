{
  "name": "texas-holdem",
  "version": "0.1.0",
  "private": true,
  "description": "极简、白色主体、响应式的 No-Limit Texas Hold'em Web 游戏（pnpm monorepo）",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint tests vitest.config.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:rules": "vitest run --project rules",
    "test:integration": "vitest run --project integration",
    "test:ws": "vitest run --project ws",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:sim": "tsx tests/simulator/run.ts",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.0"
  }
}
